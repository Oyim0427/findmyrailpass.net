# Google Analytics
# Optional. Scripts load only after the visitor accepts optional analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical domain
NEXT_PUBLIC_SITE_URL=https://findmyrailpass.net

# Advertising is disabled by default. Set both switches to true only after the
# AdSense account is approved and a Google-certified TCF CMP is configured.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_GOOGLE_CERTIFIED_CMP_READY=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=
NEXT_PUBLIC_ADSENSE_SLOT_PASSES=
NEXT_PUBLIC_ADSENSE_SLOT_PASS_DETAIL=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_OMIKUJI=

# Public /exec URL from the Google Apps Script feedback web app.
# A Google Sheets /edit URL cannot receive form submissions.
NEXT_PUBLIC_PASS_FEEDBACK_ENDPOINT=

# Paste a complete approved deep link from your affiliate dashboard.
# The site never invents tracking parameters.
NEXT_PUBLIC_AFFILIATE_RAIL_URL=

# This release has no first-party checkout and does not accept rail-pass payments.
# Add no payment or secret keys to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_CONTACT_EMAIL=
